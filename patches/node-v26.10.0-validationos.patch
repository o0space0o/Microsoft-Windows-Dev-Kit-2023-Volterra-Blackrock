+/* Match the Windows ULONG API width without truncating a size_t request. */
+static ares_bool_t ares_rand_windows(unsigned char *buf, size_t len)
+{
+  while (len != 0) {
+    ULONG count = len > ULONG_MAX ? ULONG_MAX : (ULONG)len;
+    NTSTATUS status = BCryptGenRandom(NULL, (PUCHAR)buf, count,
+                                     BCRYPT_USE_SYSTEM_PREFERRED_RNG);
+    if (status != 0) {
+      return ARES_FALSE;
+    }
+    buf += count;
+    len -= count;
+  }
+  return ARES_TRUE;
+}
 #endif
 
 
