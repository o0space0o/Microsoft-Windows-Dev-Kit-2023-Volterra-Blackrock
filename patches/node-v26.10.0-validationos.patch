+/* The WER fallback is optional on composed Windows editions. Query before
+ * resolving it so the loader does not require a static shell-folder import. */
+static int uv__get_localappdata(WCHAR** localappdata) {
+  static const GUID FOLDERID_LocalAppData_libuv = {
+    0xf1b32785, 0x6fba, 0x4fcf,
+        {0x9d, 0x55, 0x7b, 0x8e, 0x7f, 0x15, 0x70, 0x91}
+  };
+  HMODULE shell_module;
+  HRESULT result;
+  union {
+    FARPROC proc;
+    HRESULT (WINAPI *get_known_folder_path)(REFKNOWNFOLDERID,
+                                           DWORD,
+                                           HANDLE,
+                                           PWSTR*);
+  } u;
+
+  *localappdata = NULL;
+  if (!IsApiSetImplemented("ext-ms-win-shell32-shellfolders-l1-1-0"))
+    return UV_ENOSYS;
+
+  shell_module = LoadLibraryExW(L"shell32.dll",
+                                 NULL,
+                                 LOAD_LIBRARY_SEARCH_SYSTEM32);
+  if (shell_module == NULL)
+    return UV_ENOSYS;
+
+  u.proc = GetProcAddress(shell_module, "SHGetKnownFolderPath");
+  if (u.proc == NULL) {
+    FreeLibrary(shell_module);
+    return UV_ENOSYS;
+  }
+
+  result = u.get_known_folder_path(&FOLDERID_LocalAppData_libuv,
+                                   0,
+                                   NULL,
+                                   localappdata);
+  FreeLibrary(shell_module);
+  if (FAILED(result) || *localappdata == NULL) {
+    CoTaskMemFree(*localappdata);
+    *localappdata = NULL;
+    return UV_EIO;
+  }
+
+  return 0;
+}
